# Copy to .env and fill in. Values come from the install command Bindplane shows
# under Agents > Install Agent: -e is the endpoint, -s the secret key, -k the labels.
BINDPLANE_ENDPOINT=wss://app.bindplane.com/v1/opamp
BINDPLANE_SECRET_KEY=
BINDPLANE_LABELS=configuration=my-configuration

# Optional: name shown in the Bindplane UI (defaults to the container hostname)
BINDPLANE_AGENT_NAME=
